# a2e-shell runtime configuration. Values below are defaults or placeholders.
# NEVER commit real secrets. Copy to `.env` and edit locally; `.env` is git-ignored.

A2E_PORT=8080
A2E_SESSIONS_DIR=./sessions
A2E_LOG_LEVEL=info

# Bearer token(s) valid for the /sessions API. Comma-separated. No scopes in v1.
A2E_AUTH_TOKENS=

# Default capability policy applied when a session is created without overrides.
A2E_DEFAULT_BINARIES_ALLOWLIST=curl,jq,gh,aws,kubectl,git,grep,sed,awk,rg,head,tail,wc,cut,sort,uniq,xargs,pwd,echo,cat,cd,export,unset
A2E_DEFAULT_HTTP_DOMAINS_ALLOWLIST=
A2E_DEFAULT_MAX_EXEC_TIMEOUT_MS=30000
A2E_DEFAULT_MAX_RESPONSE_BYTES=262144
A2E_DEFAULT_MAX_SESSION_TTL_S=3600
A2E_DEFAULT_PREVIEW_BYTES=2048

# Env var names whose VALUES must be redacted from stdout/stderr/transcripts.
# Comma-separated env var names. The redactor reads the runtime values and scrubs matches.
A2E_REDACT_ENV_KEYS=
