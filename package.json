{
  "name": "a2e-shell",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "HTTP server exposing a real OS shell as a primitive tool for LLM agents.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/integration/golden.test.ts",
    "bench:tokens": "tsx tests/benchmarks/tokens.ts",
    "bench:http": "tsx tests/benchmarks/http.bench.ts",
    "bench:mcp": "tsx tests/benchmarks/mcp-gateway.ts",
    "bench:bounded": "tsx tests/benchmarks/bounded-vs-a2e-json.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "peggy": "^5.1.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.0",
    "gpt-tokenizer": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
