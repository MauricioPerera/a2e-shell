      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "a2e-prometheus"},
          "expr": "sum by (code) (rate(a2e_errors_total{service=\"a2e-shell\"}[5m]))",
          "legendFormat": "{{code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "a2e-prometheus"},
